<tkinter>
    <head>
        <title>Ceci est un test de balise title</title>
        <geometry>700x500</geometry>
    </head>
    <body>
        <frame weight="3">
            <label name="compteur">0</label>
            <button name="btn_compteur" action="add" args="{'label': 'compteur'}">Add</button>
        </frame>
        <frame weight="1">
            <label name="toggle">Enabled</label>
            <button action="toggle" args="{'label': 'toggle', 'button': 'btn_compteur'}">Toggle</button>
        </frame>
    </body>
</tkinter>